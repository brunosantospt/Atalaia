  "news": [
    {
      "time": "2016-08-10T22:17",
      "kind": "evacuation",
      "fact": "Two hamlets of Sobradelo da Goma parish (Póvoa de Lanhoso), Carreiras and Cabanelas, evacuated 'as a precaution' as the fire that started at 09:46 in Rossas approached; residents rehoused with family and in a municipal building. Not in OpenStreetMap, so located only by parish.",
      "parish": "Sobradelo da Goma",
      "source": "RTP live blog, 10 Aug 2016, 22:17; Lusa via JN, 11 Aug 2016",
      "url": "https://www.rtp.pt/noticias/pais/incendios-acompanhe-a-situacao-minuto-a-minuto_e939680"
    },
    {
      "time": "2016-08-11T09:00",
      "kind": "front",
      "fact": "By the morning of 11 Aug the flames had consumed an abandoned house on the hill at Agrela (Fafe), at the fire's western end (time approximate: 'de manhã').",
      "place": {
        "name": "Agrela (Fafe)",
        "lon": -8.2079624,
        "lat": 41.5428879
      },
      "source": "Operational commander Vítor Azevedo to Lusa, in JN, 11 Aug 2016",
      "url": "https://www.jn.pt/pais/artigo/fogo-de-vieira-do-minho-em-resolucao-apos-32-horas-de-combate/5334298"
    },
    {
      "time": "2016-08-11T09:00",
      "kind": "weather",
      "fact": "Strong wind with gusts of up to 80 km/h was the main difficulty for the firefighters.",
      "source": "Operational commander Vítor Azevedo to Lusa, in JN, 11 Aug 2016",
      "url": "https://www.jn.pt/pais/artigo/fogo-de-vieira-do-minho-em-resolucao-apos-32-horas-de-combate/5334298"
    },
    {
      "time": "2016-08-11T20:11",
      "kind": "resolution",
      "fact": "The fire, which had spread into Fafe and Póvoa de Lanhoso, entered 'resolution' (no longer spreading) after 32 hours of firefighting, per the national civil protection authority (ANPC); the evacuated residents had returned home.",
      "source": "JN, 11 Aug 2016, 20:11",
      "url": "https://www.jn.pt/pais/artigo/fogo-de-vieira-do-minho-em-resolucao-apos-32-horas-de-combate/5334298"
    },
    {
      "time": "2016-08-17T00:00",
      "kind": "area",
